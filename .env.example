# Discord Bot Token (получить на https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=ваш_токен_сюда

# ID сервера (Лесная Команда)
DISCORD_GUILD_ID=236652227060563969

# Discord OAuth (вход на сайт через Discord)
# Создайте приложение в Discord Developer Portal → OAuth2 → Redirects: http://localhost:8000/api/auth/discord/callback
DISCORD_CLIENT_ID=ваш_application_id
DISCORD_CLIENT_SECRET=ваш_client_secret
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# База данных (локальный PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lesnaya

# Redis (локальный)
REDIS_URL=redis://localhost:6379/0

# API URL для фронтенда
NEXT_PUBLIC_API_URL=http://localhost:8000

# Режим разработки
DEBUG=True

# Analytics & Monitoring (опционально, для production)
# Google Analytics ID (получить на https://analytics.google.com)
NEXT_PUBLIC_GA_ID=G-3437T4EM9D

# Yandex Metrika ID (получить на https://metrika.yandex.ru)
NEXT_PUBLIC_YM_ID=107194144

# Sentry DSN (получить на https://sentry.io)
NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
SENTRY_AUTH_TOKEN=xxxxx
