# Database
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379/0

# JWT Settings
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-url.com

# Discord OAuth
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
FRONTEND_URL=https://your-frontend-url.com
BACKEND_URL=https://your-backend-url.com

# Discord Bot (optional)
# DISCORD_BOT_TOKEN=your-bot-token
# DISCORD_GUILD_ID=your-guild-id

# Debug mode
DEBUG=True

# Admin credentials (used only for initial setup)
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=your-admin-password

# Game API Keys (optional)
STEAM_API_KEY=your-steam-api-key
TRACKER_API_KEY=your-tracker-gg-api-key
HENRIK_API_KEY=your-henrik-api-key
